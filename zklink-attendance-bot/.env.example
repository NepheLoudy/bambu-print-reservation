# ============================================================
# zklink-attendance-bot 环境配置（复制为 .env 后填写；.env 不进 git）
# ============================================================

# ---- 服务 ----
PORT=3017
ZK_ATT_TIMEZONE=Asia/Shanghai

# ---- 定时播报（标准 5 字段 cron：分 时 日 月 周；默认周一 09:30 上海时间，播上一周）----
ZK_ATT_BROADCAST_CRON=30 9 * * 1

# ---- 管理端点鉴权（写端点 X-API-Token；不配=写端点整体锁定，fail-closed）----
ZK_ATT_API_TOKEN=

# ---- 数据目录（部署目标上指向项目外，防 push 覆盖；本地开发可留空）----
# ZK_ATT_DATA_DIR=/c/home/qianli/zklink-attendance-data

# ---- 数据源：import=ZKLink 网页端导出打卡明细上传（默认，今天就能用）
#              http=ZKLink 接口直拉（凭据+端点校准后才可切）
ZKLINK_DATA_SOURCE=import

# ---- ZKLink 平台（zklink.zktecoiot.com，考勤组/规则已在平台侧配好）----
ZKLINK_BASE_URL=https://zklink.zktecoiot.com
ZKLINK_USERNAME=
ZKLINK_PASSWORD=
# 登录/拉数端点为候选值，凭据到位后跑 node scripts/zklink-probe.js 校准，再回填：
ZKLINK_LOGIN_PATH=/oauth/token
ZKLINK_TRANSACTION_PATH=/zkbio_att/api/attendance/transaction/list
# 考勤组 ID（平台创建考勤组后可得；留空=不过滤按全组织拉）
ZKLINK_ATT_GROUP_ID=

# ---- 播报通道：值日群自定义机器人 webhook（飞书群 → 设置 → 群机器人 → 添加自定义机器人）----
FEISHU_WEBHOOK_URL=
# 机器人开了「签名校验」才需要填
FEISHU_WEBHOOK_SECRET=

# ---- 云文档留档（飞书应用身份 docx API 追加周报留档）----
# 需要一个飞书应用（或复用现有应用）开通 docx 权限，并把它加为目标云文档的协作者（可编辑）；
# ARCHIVE_DOC_TOKEN 填云文档 URL 里 /docx/ 后面那段 token
FEISHU_APP_ID=
FEISHU_APP_SECRET=
ARCHIVE_DOC_TOKEN=

# ---- 部署目标（小电脑 DESKTOP-FE1MIGI；凭据与 approval-bot/.env 同值，勿入库）----
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASSWORD=
