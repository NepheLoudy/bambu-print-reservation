# ---------- 服务 ----------
PORT=3007

# ---------- 企业微信（管理后台 https://work.weixin.qq.com） ----------
# 我的企业 → 企业信息 → 企业ID
WECOM_CORP_ID=
# 自建应用 Secret。前置一次性配置：
#   ① 应用管理 → 自建 → 创建应用（如「考勤播报」）
#   ② 管理后台「打卡」应用 → 可调用接口的应用 → 勾选该自建应用（拉打卡数据的前提）
#   ③ 自建应用详情 → 开发者接口 → 可信IP：填部署目标出口公网 IP（家宽 IP 变动后要回来更新，否则拉数报 60020）
#   ④ 成员需在应用可见范围内
WECOM_ATTENDANCE_SECRET=
# 负责人群 → 添加群机器人 → webhook 地址 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=XXXX 的 key 段
# 注意：webhook 发送不走可信 IP 校验，只有拉数接口受可信 IP 限制
WECOM_WEBHOOK_KEY=

# ---------- 定时播报 ----------
# 5 字段 cron（分 时 日 月 周），默认每周一 09:30 播上一完整周（周一~周日）；时区 Asia/Shanghai（无夏令时）
# 发送时刻请保持在 09:00 晚间静默窗口之外（本服务为单次周播，不落静默积压机制，见 README）
ATTENDANCE_BROADCAST_CRON=30 9 * * 1
ATTENDANCE_TIMEZONE=Asia/Shanghai

# ---------- 管理端点鉴权（X-API-Token，值与全工作区共享 token 同值，见顶层 AGENTS「全局工程规则」） ----------
# 未配置 = 写端点整体锁定（fail-closed）；只读 GET 与 /api/health 不受限
ATTENDANCE_API_TOKEN=

# ---------- 运行时数据（部署目标上放项目外数据目录，见顶层 AGENTS「运行时数据保护」） ----------
ATTENDANCE_DATA_DIR=/home/qianli/wecom-attendance-data
# 不填用默认：members=config/members.json（不进 git），state=$DATA_DIR/.attendance-state.json，exports=$DATA_DIR/exports/
ATTENDANCE_MEMBERS_FILE=
ATTENDANCE_STATE_FILE=
ATTENDANCE_EXPORTS_DIR=

# ---------- 部署（push.js 用；NAS_ 为历史命名，语义=部署目标=小电脑 DESKTOP-FE1MIGI） ----------
NAS_HOST=192.168.31.57
NAS_PORT=22
NAS_USER=mechax
NAS_PASSWORD=
