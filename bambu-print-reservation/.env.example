# 服务器配置
PORT=3001

# 飞书配置（qianli 项目群共用应用；事件由 feishu-gateway 唯一长连接转发，本服务不开长连接）
APP_ID=cli_xxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_USE_LONG_CONNECTION=false

# 飞书多维表格配置
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
BITABLE_RESERVATION_TABLE_ID=tblXXXXXXXXXXXXXX
BITABLE_PRINTER_TABLE_ID=tblXXXXXXXXXXXXXX

# 飞书事件订阅配置
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书机器人配置
BOT_NAME=爆米花机-对话型
BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BOT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 打印机配置 (多台用逗号分隔，按位置对齐；X1/H2D 走 SFTP 22，P1/A1 走 FTP 21；
# 非 Bambu 机型如闪铸只登记展示，不参与自动分发)
PRINTER_HOSTS=192.168.1.100,192.168.1.101,192.168.1.102,192.168.1.103
PRINTER_ACCESS_CODES=xxxxxxxx,xxxxxxxx,xxxxxxxx,xxxxxxxx
PRINTER_SERIALS=SNxxxxxxxxx,SNxxxxxxxxx,SNxxxxxxxxx,SNxxxxxxxxx
PRINTER_NAMES=X1C-01,X1C-02,H2D,闪铸AD5M
PRINTER_MODELS=X1C,X1C,H2D,ADVENTURER5

# 审批者配置（指定成员open_id，逗号分隔）
REVIEWERS=ou_xxxxxxxxxxxxxxxx

# ---------------- 官方审批直连（分发主通道） ----------------
# 审批实例事件（approval_instance）秒级驱动分发；多维表格仅是半小时级同步镜像
APPROVAL_PRIMARY=true
# 审批定义 code（审批管理后台可查）。留空 = 不过滤：网关会把共用应用的全部审批实例
# 事件转发到本服务，任何「已通过且含附件」的审批都会被当成打印申请下发到真机，务必配置
APPROVAL_CODE=
# （拿到 code 后一次性订阅：node -e "require('./src/services/approvalService').subscribeApproval('<code>')"）
# 审批事件丢失自愈：每 N 分钟对账补入队（含拉详情失败重拉）；0 = 关闭
APPROVAL_RECONCILE_MINUTES=5
# 对账回看窗口（分钟，按实例提交时间）；窗口列表兜底需配置 APPROVAL_CODE（列表接口必须指定审批定义）
APPROVAL_RECONCILE_WINDOW_MINUTES=1440

# ---------------- 分发引擎 ----------------
# 审批表单字段名（与多维表格字段一致）
DISPATCH_MATERIAL_FIELD=材料类型
DISPATCH_COLOR_FIELD=颜色
DISPATCH_PRINTER_FIELD=指定打印机
# 颜色近似匹配阈值（redmean 距离 0-765，越大越宽松）
DISPATCH_COLOR_THRESHOLD=120
# 对账兜底间隔（分钟）：仅后备模式（APPROVAL_PRIMARY=false）生效，主通道下对账关闭、此配置无效
DISPATCH_RECONCILE_MINUTES=2
# 缺料提醒重发间隔（分钟）
DISPATCH_MATERIAL_REMIND_MINUTES=30
# 打印是否由 AMS 供料
DISPATCH_USE_AMS=true
# 分发失败重试上限（超过后退出队列转人工）
DISPATCH_MAX_RETRIES=3
# 分发失败重试冷却（毫秒）
DISPATCH_RETRY_COOLDOWN_MS=60000

# ---------------- NAS 部署配置（push.js 用，严禁提交） ----------------
NAS_HOST=10.253.33.233
NAS_PORT=8500
NAS_USER=qianli
NAS_PASSWORD=

# 自动审批：审批流「自动审批」节点审批人 open_id，机器人按 AMS 匹配规则自动同意；留空 = 不自动审批
APPROVAL_AUTO_APPROVER_ID=

# ---------------- 晚间静默（播报时段限制） ----------------
# 播报静默窗口 [START, END)（Asia/Shanghai 整点）：窗口内定时/自动播报不直接发送，
# 积压到 END 整点统一补发（任务类重跑取补发时刻数据；一次性通知原样补发）。
# 对话/指令回复与人工当下主动触发不受限。默认 2→9，留空即默认。
# QUIET_HOURS_START=2
# QUIET_HOURS_END=9
# QUIET_HOURS_DISABLED=1
# 积压文件落盘路径（可选）：挪到项目目录外可免 SFTP 部署清空丢积压
# QUIET_BACKLOG_FILE=/home/qianli/bambu-data/quiet-backlog.json
