# ---------------- 服务 ----------------
PORT=3010

# ---------------- 飞书应用（qianli 项目群共用应用） ----------------
# 注意：本网关是唯一持有长连接的进程，各机器人必须设置 FEISHU_USE_LONG_CONNECTION=false
APP_ID=cli_aac7e6f6cdf8dcc0
APP_SECRET=

# ---------------- 事件订阅 ----------------
# 长连接订阅的事件类型（逗号分隔），接入新事件类型在这里加
EVENT_TYPES=im.message.receive_v1,drive.file.bitable_record_changed_v1

# ---------------- 下游机器人消费者 ----------------
# 格式：名称|事件回调URL|指令转发URL(可选)|标记(可选)
# 标记 legacy = 按旧版事件结构（bitable.record.create/update + record.fields）转发该机器人
CONSUMERS=hub|http://localhost:2174/api/feishu/event;approval|http://localhost:3002/api/feishu/event|http://localhost:3002/api/chat/command;bambu|http://localhost:3001/api/feishu/event|http://localhost:3001/api/chat/command|legacy;ticket|http://localhost:3003/api/feishu/event

# ---------------- 消息事件路由 ----------------
# JSON 数组，按顺序匹配，命中即停；全部未命中转发给 DEFAULT_TARGET（event 模式）
# match 字段：chatId / mention / prefix / contains（同一规则内 AND 关系）
# mode：event=转发原始事件到事件回调；command=解析 /指令 后 POST 到指令端点，由网关代为回复结果
# 示例（优先级从高到低）：
# MESSAGE_ROUTES=[{"match":{"chatId":"oc_xxx"},"target":"approval","mode":"event"},{"match":{"prefix":"/approval"},"target":"approval","mode":"command"}]
MESSAGE_ROUTES=
DEFAULT_TARGET=hub

# ---------------- 多维表格事件 ----------------
# 广播目标（逗号分隔消费者名，留空=全部消费者；各机器人按 table_id 自行过滤）
BITABLE_TARGETS=
# 需要订阅记录变更的云文档 appToken（逗号分隔，网关启动时幂等调用订阅接口）
DOC_SUBSCRIBES=

# ---------------- 透传给机器人的校验token（可选） ----------------
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------------- NAS 部署配置（push.js 用，严禁提交） ----------------
NAS_HOST=10.253.33.233
NAS_PORT=8500
NAS_USER=qianli
NAS_PASSWORD=
